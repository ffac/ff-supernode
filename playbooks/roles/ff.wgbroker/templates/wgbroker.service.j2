[Unit]
Description=A broker to add new wireguard keys to the network
Wants=network.target
After=network.target

[Service]
User=auto
WorkingDirectory=/home/auto
Environment="PYTHONUNBUFFERED=TRUE"
# Loopback only: nginx is the front, and a directly reachable worker would
# let anyone hand in their own X-Forwarded-For and step around the per-source
# rate limit.
ExecStart=/usr/bin/gunicorn -b 127.0.0.1:8000 broker:app
Restart=always

[Install]
WantedBy=multi-user.target
