{% for peer in peerings | default([]) %}
protocol {{ peer.protocol }} {{ peer.name }} {% if peer.templates %}{% for template in peer.templates %}from {{ template }}{% endfor %}{% endif %} {
    description "{{ peer.description }}";
    neighbor {{ peer.neighbor }} as {{ peer.remote_as }};
    source address {{ peer.source_address }};
{% if peer.default_local_pref is defined %}
    default bgp_local_pref {{ peer.default_local_pref }};
{% endif %}
};
{% endfor %}
