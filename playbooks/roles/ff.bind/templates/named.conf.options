acl "xfer" {
	/* Deny transfers by default except for the listed hosts.
	 * If we have other name servers, place them here.
	 */
	none;
};

acl recursive_internal {
	127.0.0.1/32;
	::1/128;
	10.5.0.0/16;
	10.145.0.0/16;
	fe80::/64;
	fdac::/64;
	fda0:747e:ab29:acac::/64;
	2a03:2260:114::/48;
	2a03:2260:3006::/48;
	2a03:2260:40:0::/64;
	2a00:fe0:43::/48;
	5.145.135.128/27;
	185.66.193.40/29;
};

acl recursive_external {
	0.0.0.0/0;
    ::/0;
};

view "internal" {
    match-clients { recursive_internal; };

	allow-query {
		recursive_internal;
	};

	allow-query-cache {
		recursive_internal;
	};

	allow-recursion {
		recursive_internal;
	};

	allow-transfer {
		none;
	};

	allow-update {
		none;
	};

//    include "/etc/bind/named.conf.local";
    include "/etc/bind/named.conf.default-zones";
    include "/etc/bind/named.conf.zones";
    include "/etc/bind/zones.rfc1918";
};

view "external" {
    match-clients { recursive_external; };

    rate-limit {
        responses-per-second 5;
        window 5;
        slip 2;
        max-table-size 200000;
    };

	allow-query {
		recursive_external;
	};

	allow-query-cache {
		recursive_external;
	};

	allow-recursion {
		recursive_external;
	};

	allow-transfer {
		none;
	};

	allow-update {
		none;
	};


//    include "/etc/bind/named.conf.local";
    include "/etc/bind/named.conf.default-zones";
//    include "/etc/bind/named.conf.zones";
    include "/etc/bind/zones.rfc1918";
};


options {
	directory "/var/cache/bind";
	statistics-file "/var/log/named/named.stats";


	// If there is a firewall between you and nameservers you want
	// to talk to, you may need to fix the firewall to allow multiple
	// ports to talk.  See http://www.kb.cert.org/vuls/id/800113

	// If your ISP provided one or more IP addresses for stable
	// nameservers, you probably want to use them as forwarders.
	// Uncomment the following block, and insert the addresses replacing
	// the all-0's placeholder.

	// forwarders {
	// 	10.5.0.2;
	// };

	listen-on {
{% for listen_addr in dns_v4_listen_addrs | default( [] ) %}
		{{ listen_addr }};
{% endfor %}
	};

	listen-on-v6 {
{% for listen_addr in dns_v6_listen_addrs | default( [] ) %}
		{{ listen_addr }};
{% endfor %}
	};


//	notify-source 5.61.84.134;
//	notify-source-v6 2a00:5f40:1001:ffac::babe;

	//========================================================================
	// If BIND logs error messages about the root key being expired,
	// you will need to update your keys.  See https://www.isc.org/bind-keys
	//========================================================================

	version "unknown";

#	dnssec-validation auto;
#	dnssec-lookaside auto;
	dnssec-validation no;

	empty-zones-enable no;

	querylog no;

	auth-nxdomain no;    # conform to RFC1035

	recursive-clients 10000;
	tcp-clients 1000;
	max-cache-size 350M;
	
	# RFC8767
	stale-cache-enable yes;
	stale-answer-enable yes;
	max-stale-ttl 7d;
	stale-answer-ttl 67s;
	stale-refresh-time 30s;

};
