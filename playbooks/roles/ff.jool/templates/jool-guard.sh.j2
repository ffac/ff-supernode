#!/bin/sh
# NAT64 source guard for Jool on {{ inventory_hostname }}.
#
# Jool registers a PRE_ROUTING hook only, so it translates every forwarded
# packet addressed to the NAT64 prefix no matter where that packet came from.
# Left alone, the host is an open NAT64 relay: anyone who can route a packet
# to the pool6 prefix gets their IPv4 traffic masked with our address.
#
# The chain is jumped to only for packets addressed to the NAT64 prefix, so it
# cannot affect the host's other IPv6 forwarding. Raw PREROUTING runs at
# priority -300, ahead of Jool's -75, so nothing is translated before the
# source has been checked.
#
# A source prefix is not an identity: anyone can put it in a packet header.
# With jool_source6_interface set, the jump additionally matches the interface
# the traffic has to arrive on - on a concentrator the wireguard interface,
# where the peer's allowed-ips already decided which source may appear at all.
# Both checks are kept: the interface proves the packet came through the
# tunnel, the prefix that the peer may use the NAT64.
#
# The chain is built the fail-closed way round: the terminal DROP is created
# before the chain is reachable at all and stays the last rule, so the user
# chain is never empty - an empty chain returns every packet instead of
# dropping it. Permissions are only inserted above the DROP, and stale ones are
# deleted by name, never by flushing the chain. A run that dies halfway
# therefore leaves the guard stricter than required, not open, and a raw table
# flushed by a reboot is rebuilt on the next boot.
#
# Generated by the ff.jool role - edit the template, not this file.

set -eu

chain=JOOL_GUARD
pool6='{{ jool_pool6 }}'
allowed='{{ jool_source6_allow | join(" ") }}'
iface='{{ jool_source6_interface }}'

ipt() {
    ip6tables -w -t raw "$@"
}

# 1. The chain, with its terminal DROP, before anything can jump into it.
if ! ipt -N "$chain" 2>/dev/null; then
    :
fi
if ! ipt -C "$chain" -j DROP 2>/dev/null; then
    ipt -A "$chain" -j DROP
fi

# 2. The jump from PREROUTING, only for traffic addressed to the NAT64 prefix.
if [ -n "$iface" ]; then
    jump="-d $pool6 -i $iface"
else
    jump="-d $pool6"
fi
if ! ipt -C PREROUTING $jump -j "$chain" 2>/dev/null; then
    ipt -I PREROUTING 1 $jump -j "$chain"
fi

# 3. One RETURN above the DROP per allowed source prefix.
for src in $allowed; do
    if ! ipt -C "$chain" -s "$src" -j RETURN 2>/dev/null; then
        ipt -I "$chain" 1 -s "$src" -j RETURN
    fi
done

# 4. Delete RETURN rules for prefixes that are no longer allowed.
ipt -S "$chain" | while read -r rule; do
    case "$rule" in
    "-A $chain -s "*" -j RETURN")
        src=${rule#"-A $chain -s "}
        src=${src%" -j RETURN"}
        case " $allowed " in
        *" $src "*) ;;
        *) ipt -D "$chain" -s "$src" -j RETURN ;;
        esac
        ;;
    esac
done

# 5. Delete jumps for a pool6 or interface that is no longer configured.
ipt -S PREROUTING | while read -r rule; do
    case "$rule" in
    "-A PREROUTING "*) ;;
    *) continue ;;
    esac
    case "$rule" in
    *"-j $chain") ;;
    *) continue ;;
    esac
    dst=''
    got=''
    prev=''
    for tok in $rule; do
        case "$prev" in
        -d) dst=$tok ;;
        -i) got=$tok ;;
        esac
        prev=$tok
    done
    # A jump without a destination was not written by this script; deleting it
    # would need its exact argument list, and leaving it only makes the guard
    # stricter. Our own rules always carry -d.
    [ -n "$dst" ] || continue
    if [ "$dst" != "$pool6" ] || [ "$got" != "$iface" ]; then
        del="-d $dst"
        if [ -n "$got" ]; then
            del="$del -i $got"
        fi
        ipt -D PREROUTING $del -j "$chain"
    fi
done
